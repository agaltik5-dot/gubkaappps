<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#8E8E93" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
    <!-- Активная точка (скрывается/показывается динамически) -->
    <item android:id="@+id/inner_dot" android:top="5dp" android:bottom="5dp" android:left="5dp" android:right="5dp">
        <shape android:shape="oval">
            <solid android:color="#007AFF" />
        </shape>
    </item>
</layer-list>