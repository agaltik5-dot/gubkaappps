<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:orientation="vertical">

    <!-- Хедер -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/ui_text_main" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Настройки темы"
            android:textColor="@color/ui_text_main"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- БЛОК "СОЗДАТЬ ТЕМУ" -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/ui_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="12dp"
                        android:text="Создать тему"
                        android:textColor="#8BC34A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- 1. ПРЕДПРОСМОТР ТЕМ (СВЕТЛАЯ / ТЁМНАЯ) С ТОЧКАМИ ИНДИКАТОРАМИ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <!-- Дневная (Белая) -->
                        <LinearLayout
                            android:id="@+id/btn_mode_light"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:id="@+id/card_light_preview"
                                android:layout_width="80dp"
                                android:layout_height="120dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="#FFFFFF"
                                android:elevation="2dp">

                                <ImageView
                                    android:id="@+id/dot_light"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="bottom|center_horizontal"
                                    android:layout_marginBottom="8dp"
                                    android:src="@drawable/ic_theme_radio_dot" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Дневная"
                                android:textColor="@color/ui_text_main"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Тёмная (Черная) -->
                        <LinearLayout
                            android:id="@+id/btn_mode_dark"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <FrameLayout
                                android:id="@+id/card_dark_preview"
                                android:layout_width="80dp"
                                android:layout_height="120dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="#1E232A"
                                android:elevation="2dp">

                                <ImageView
                                    android:id="@+id/dot_dark"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="bottom|center_horizontal"
                                    android:layout_marginBottom="8dp"
                                    android:src="@drawable/ic_theme_radio_dot" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Тёмная"
                                android:textColor="@color/ui_text_main"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Палитра цветных кружочков в стиле Telegram -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <!-- Голубой -->
                            <View
                                android:id="@+id/color_cyan"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_margin="6dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="#4FC3F7" />

                            <!-- Розовый -->
                            <View
                                android:id="@+id/color_pink"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_margin="6dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="#F06292" />

                            <!-- Фиолетовый -->
                            <View
                                android:id="@+id/color_purple"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_margin="6dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="#BA68C8" />

                            <!-- Салатовый -->
                            <View
                                android:id="@+id/color_light_green"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_margin="6dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="#9CCC65" />

                            <!-- Бирюзовый -->
                            <View
                                android:id="@+id/color_teal"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_margin="6dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="#4DD0E1" />

                            <!-- Желтый -->
                            <View
                                android:id="@+id/color_yellow"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_margin="6dp"
                                android:background="@drawable/bg_icon_rounded"
                                android:backgroundTint="#FFEE58" />

                        </LinearLayout>
                    </HorizontalScrollView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>