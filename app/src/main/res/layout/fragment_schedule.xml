<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg">

    <!-- 1. Заголовок (Расписание / Дата) -->

    <!-- 2. Список дней недели (Сетка на весь экран) -->

    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Расписание"
            android:textColor="@color/ui_text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Четверг, 16 Июля"
            android:textColor="@color/ui_text_sub"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 2. Навигация по месяцам/неделям -->

    <LinearLayout
        android:id="@+id/layout_month_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header"
        tools:layout_editor_absoluteX="0dp">

        <ImageButton
            android:id="@+id/btn_prev_week"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/ui_text_main" />

        <TextView
            android:id="@+id/tv_month_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Июль 2026"
            android:textColor="@color/ui_text_main"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_next_week"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/ui_text_main" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:weightSum="7"
        app:layout_constraintTop_toBottomOf="@id/layout_month_nav">

        <!-- ПН -->
        <LinearLayout
            android:id="@+id/day_mon"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_inactive"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПН"
                android:textColor="@color/ui_text_sub"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13"
                android:textColor="@color/ui_text_main"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ВТ (Активный) -->
        <LinearLayout
            android:id="@+id/day_tue"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_inactive"
            android:gravity="center"
            android:orientation="vertical"
            android:elevation="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ВТ"
                android:textColor="@color/ui_text_sub"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14"
                android:textColor="@color/ui_text_main"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- СР -->
        <LinearLayout
            android:id="@+id/day_wed"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_inactive"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СР"
                android:textColor="@color/ui_text_sub"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15"
                android:textColor="@color/ui_text_main"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ЧТ -->
        <LinearLayout
            android:id="@+id/day_thu"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_inactive"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ЧТ"
                android:textColor="@color/ui_text_sub"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16"
                android:textColor="@color/ui_text_main"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ПТ -->
        <LinearLayout
            android:id="@+id/day_fri"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_inactive"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПТ"
                android:textColor="@color/ui_text_sub"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17"
                android:textColor="@color/ui_text_main"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- СБ -->
        <LinearLayout
            android:id="@+id/day_sat"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_inactive"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СБ"
                android:textColor="@color/ui_text_sub"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18"
                android:textColor="@color/ui_text_main"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ВС -->
        <LinearLayout
            android:id="@+id/day_sun"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_day_inactive"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ВС"
                android:textColor="@color/ui_text_sub"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19"
                android:textColor="@color/ui_text_main"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. ViewPager2 для свайпов между днями -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_schedule"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_days" />

</androidx.constraintlayout.widget.ConstraintLayout>